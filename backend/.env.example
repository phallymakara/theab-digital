# Digital Theab Backend Configuration Example
ENVIRONMENT=development
DATABASE_URL=postgresql://user:password@ep-xyz.ap-southeast-1.neon.tech/neondb?sslmode=require
SECRET_KEY=generate-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:5174,https://theab-digital.vercel.app

# Cloudflare R2 Media Storage (Optional, falls back to local disk if omitted)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=theab-digital-media
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Superadmin Configuration (Optional seed)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change_this_secure_password

